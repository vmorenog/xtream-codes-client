# Secrets — provider credentials, tokens, playlists
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local media / playlist dumps.
# Note: NOT `*.ts`. MPEG transport streams share that extension with
# TypeScript, and ignoring it would silently hide vite.config.ts. Anything
# actually captured from a provider goes in media/.
media/
*.m3u
*.m3u8
*.mp4
*.mkv

# Dependencies & build output
node_modules/
dist/
src-tauri/target/
src-tauri/gen/schemas/

# Caches
.cache/
coverage/
*.log

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Claude Code local overrides
.claude/settings.local.json
