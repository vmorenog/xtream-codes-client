# Generated by .github/workflows/release.yml on every tag. Do not hand-edit the
# copy in the tap: the next release overwrites it.
cask "xtream" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/vmorenog/xtream-codes-client/releases/download/v#{version}/Xtream-#{version}-universal.dmg"
  name "Xtream"
  desc "IPTV client for Xtream Codes providers"
  homepage "https://github.com/vmorenog/xtream-codes-client"

  # Playback is delegated to mpv rather than bundled (ADR-0003), which is the
  # main reason this is a cask and not a bare .dmg download.
  depends_on formula: "mpv"
  depends_on macos: ">= :big_sur"

  app "Xtream.app"

  # The app is not signed by Apple (ADR-0009), so it must be installed with
  # `--no-quarantine` or Gatekeeper blocks it. A cask cannot waive that itself.
  caveats <<~EOS
    Xtream is not signed by Apple. If you did not install it with
    `--no-quarantine`, macOS will refuse to open it:

      brew install --cask --no-quarantine vmorenog/tap/xtream

  EOS

  zap trash: [
    "~/Library/Application Support/com.vmorenog.xtream-codes-client",
    "~/Library/Caches/com.vmorenog.xtream-codes-client",
    "~/Library/WebKit/com.vmorenog.xtream-codes-client",
  ]
end
